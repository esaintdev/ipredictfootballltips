# Postgres connection string (Supabase: Project Settings → Database → Connection string → "Transaction pooler" URI)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# API-Football key from https://dashboard.api-football.com (RAPIDAPI_KEY also works if you subscribed via RapidAPI)
API_FOOTBALL_KEY=

# Owner admin account, created on first login if no admin exists yet
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# Long random strings (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://ipredictfootballtips.com
